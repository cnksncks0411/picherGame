{
  "name": "wie-web",
  "version": "0.1.0",
  "description": "WIPI/J2ME feature phone emulator - web frontend",
  "type": "module",
  "scripts": {
    "start": "vite --config wie-web/vite.config.ts",
    "play": "npm run build:prod && npm run preview",
    "build:dev": "vite build --config wie-web/vite.config.ts --mode development",
    "build:prod": "vite build --config wie-web/vite.config.ts",
    "preview": "vite preview --config wie-web/vite.config.ts",
    "typecheck": "tsc --noEmit -p wie-web/tsconfig.json"
  },
  "author": "",
  "dependencies": {
    "lucide-react": "^1.43.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "spessasynth_lib": "^4.3.14"
  },
  "private": true,
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "stb-vorbis": "0.0.5"
  }
}
